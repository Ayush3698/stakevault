# RPC endpoint for Sepolia (e.g. from Alchemy, Infura, or a public RPC)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# Private key of the deployer wallet (needs Sepolia ETH for gas)
# NEVER commit a real private key. This file is .env.example only.
DEPLOYER_PRIVATE_KEY=

# Optional: for `npm run verify:sepolia` (Etherscan contract verification)
ETHERSCAN_API_KEY=
